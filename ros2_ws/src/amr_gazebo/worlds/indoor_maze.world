<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="indoor_maze">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- Outer Walls (10x10 meters environment) -->
    <!-- South Wall -->
    <model name="wall_south">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- North Wall -->
    <model name="wall_north">
      <static>true</static>
      <pose>5 10 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- West Wall -->
    <model name="wall_west">
      <static>true</static>
      <pose>0 5 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- East Wall -->
    <model name="wall_east">
      <static>true</static>
      <pose>10 5 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>10.2 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Inner Maze Walls & Barriers -->
    <model name="inner_wall_1">
      <static>true</static>
      <pose>3 3 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>4.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>4.0 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_wall_2">
      <static>true</static>
      <pose>7 6 1 0 0 1.5708</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>5.0 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>5.0 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <model name="inner_wall_3">
      <static>true</static>
      <pose>4 8 1 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>3.5 0.2 2.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>3.5 0.2 2.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Static Obstacle Box -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>2 6 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></visual>
      </link>
    </model>

    <!-- Dynamic Obstacle Cylinder (Can be controlled or scripted) -->
    <model name="dynamic_obstacle">
      <static>false</static>
      <pose>5 5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.4</radius><length>1.0</length></cylinder></geometry></visual>
      </link>
    </model>

  </world>
</sdf>
